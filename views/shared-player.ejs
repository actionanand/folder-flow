<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Folder Flow — <%= label %></title>
  <link rel="icon" href="/favicon.ico" type="image/x-icon">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="<%= mimeType ? '' : 'login-page' %>">
  <% if (!mimeType) { %>
    <!-- PIN entry for shared stream -->
    <div class="login-card">
      <div class="login-logo">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <polygon points="5 3 19 12 5 21 5 3"/>
        </svg>
        <h1><%= label %></h1>
        <% if (live) { %>
          <span class="live-badge">🔴 LIVE</span>
        <% } %>
        <p class="subtitle">Enter the stream PIN to watch</p>
      </div>
      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>
      <form method="POST" action="/s/<%= token %>" autocomplete="off">
        <input type="password" name="pin" placeholder="Stream PIN" autofocus required class="pin-input">
        <button type="submit" class="btn btn-primary btn-block">Watch</button>
      </form>
    </div>
  <% } else { %>
    <!-- Player -->
    <header class="topbar">
      <div class="topbar-left">
        <span class="logo">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <polygon points="5 3 19 12 5 21 5 3"/>
          </svg>
          <%= label %>
          <% if (live) { %><span class="live-badge" style="margin-left:8px;">🔴 LIVE</span><% } %>
        </span>
      </div>
      <div class="topbar-right">
        <select id="audio-track-select" class="input" style="width:auto;display:none;font-size:12px;padding:4px 8px;">
        </select>
      </div>
    </header>
    <% if (live) { %>
    <div id="countdown-overlay" class="countdown-overlay" style="display:none;">
      <div class="countdown-content">
        <span class="live-badge" style="font-size:18px;padding:8px 20px;">🔴 LIVE</span>
        <h2 style="margin:20px 0 8px;">Stream starting soon</h2>
        <div id="countdown-timer" class="countdown-timer"></div>
        <p style="color:var(--text-muted);margin-top:12px;">Stay on this page. Playback will begin automatically.</p>
      </div>
    </div>
    <% } %>
    <main class="container player-container">
      <div class="player-wrapper">
        <% if (isAudio) { %>
          <audio id="media-player" <% if (!live) { %>controls autoplay<% } %> class="audio-player">
            <source src="/s/<%= token %>/data" type="<%= mimeType %>">
            Your browser does not support audio playback.
          </audio>
          <% if (live) { %>
            <div class="live-overlay">
              <p>🔴 Live Audio — Playback controlled by the host</p>
            </div>
          <% } %>
        <% } else { %>
          <video id="media-player" <% if (!live) { %>controls autoplay<% } else { %>disablePictureInPicture controlsList="nodownload noplaybackrate"<% } %> class="video-player">
            <source src="/s/<%= token %>/data" type="<%= mimeType %>">
            Your browser does not support video playback.
          </video>
          <% if (live) { %>
            <div class="live-controls">
              <button onclick="document.getElementById('media-player').play()" class="btn btn-sm btn-outline">▶ Play</button>
              <button onclick="document.getElementById('media-player').pause()" class="btn btn-sm btn-outline">⏸ Pause</button>
              <span class="live-badge" style="margin-left:auto;">🔴 LIVE</span>
            </div>
          <% } %>
        <% } %>
      </div>
    </main>
    <script>
      (function() {
        var player = document.getElementById('media-player');
        var trackSelect = document.getElementById('audio-track-select');
        if (!player) return;

        <% if (live) { %>
        // Block keyboard seek shortcuts
        document.addEventListener('keydown', function(e) {
          if (['ArrowLeft','ArrowRight','Home','End'].indexOf(e.key) !== -1) {
            e.preventDefault();
          }
        });
        // Disable right-click context menu
        player.addEventListener('contextmenu', function(e) { e.preventDefault(); });

        // Live sync with server
        var countdownEl = document.getElementById('countdown-overlay');
        var timerEl = document.getElementById('countdown-timer');
        var firstSync = true;
        var countdownInterval = null;

        function fetchSync() {
          return fetch('/s/<%= token %>/sync').then(function(r) { return r.json(); });
        }

        function showCountdown(ms) {
          countdownEl.style.display = 'flex';
          player.pause();
          if (countdownInterval) clearInterval(countdownInterval);
          function tick() {
            if (ms <= 0) {
              countdownEl.style.display = 'none';
              if (countdownInterval) { clearInterval(countdownInterval); countdownInterval = null; }
              fetchSync().then(handleSync);
              return;
            }
            var s = Math.ceil(ms / 1000);
            var m = Math.floor(s / 60);
            s = s % 60;
            timerEl.textContent = (m > 0 ? m + 'm ' : '') + (s < 10 ? '0' : '') + s + 's';
            ms -= 1000;
          }
          tick();
          countdownInterval = setInterval(tick, 1000);
        }

        function handleSync(data) {
          if (!data.started) {
            showCountdown(data.startsInMs);
          } else {
            if (countdownEl) countdownEl.style.display = 'none';
            if (countdownInterval) { clearInterval(countdownInterval); countdownInterval = null; }
            if (Math.abs(player.currentTime - data.elapsed) > 3) {
              player.currentTime = data.elapsed;
            }
            if (firstSync) {
              firstSync = false;
              player.play().catch(function(){});
            }
          }
        }

        // Snap to live position on seek attempt
        player.addEventListener('seeking', function() {
          fetchSync().then(function(data) {
            if (data.started && Math.abs(player.currentTime - data.elapsed) > 3) {
              player.currentTime = data.elapsed;
            }
          });
        });

        // Initial sync + periodic re-sync
        fetchSync().then(handleSync);
        setInterval(function() { fetchSync().then(handleSync); }, 30000);
        <% } %>

        // Audio track selection (for videos with multiple audio tracks)
        if (player.audioTracks) {
          function populateTracks() {
            if (player.audioTracks.length > 1) {
              trackSelect.style.display = 'inline-block';
              trackSelect.innerHTML = '';
              for (var i = 0; i < player.audioTracks.length; i++) {
                var t = player.audioTracks[i];
                var opt = document.createElement('option');
                opt.value = i;
                opt.textContent = t.label || t.language || ('Track ' + (i + 1));
                if (t.enabled) opt.selected = true;
                trackSelect.appendChild(opt);
              }
            }
          }
          player.audioTracks.addEventListener('addtrack', populateTracks);
          populateTracks();
          trackSelect.addEventListener('change', function() {
            for (var i = 0; i < player.audioTracks.length; i++) {
              player.audioTracks[i].enabled = (i === parseInt(this.value));
            }
          });
        }
      })();
    </script>
  <% } %>
</body>
</html>
