<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Folder Flow — Stream Shared!</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="topbar">
    <div class="topbar-left">
      <a href="/" class="logo">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/>
        </svg>
        Folder Flow
      </a>
    </div>
    <div class="topbar-right">
      <a href="/" class="btn btn-sm btn-outline">← Files</a>
      <a href="/streams" class="btn btn-sm btn-outline">Streams</a>
    </div>
  </header>

  <main class="container" style="text-align:center;max-width:500px;">
    <div class="info-card" style="margin-top:32px;">
      <h2>🎬 Stream Ready!</h2>
      <p style="margin-bottom:16px;color:var(--text-muted);"><%= label %></p>
      <p class="info-url"><%= shareUrl %></p>
      <div class="qr-wrap">
        <img src="<%= qr %>" alt="Stream QR Code">
      </div>
      <p class="info-hint">Share this URL or scan the QR code.<br>The viewer will need the stream PIN you set.</p>
      <div style="margin-top:20px;display:flex;gap:8px;justify-content:center;">
        <a href="/streams" class="btn btn-outline">Manage Streams</a>
        <a href="/" class="btn btn-primary">← Back to Files</a>
      </div>
    </div>
  </main>
</body>
</html>
