<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Folder Flow — Active Streams</title>
  <link rel="icon" href="/favicon.ico" type="image/x-icon">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="topbar">
    <div class="topbar-left">
      <a href="/" class="logo">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/>
        </svg>
        Folder Flow
      </a>
    </div>
    <div class="topbar-right">
      <a href="/" class="btn btn-sm btn-outline">← Files</a>
    </div>
  </header>

  <main class="container">
    <h2 style="margin-bottom:16px;">🎬 Active Streams</h2>

    <% if (streams.length === 0) { %>
      <div class="info-card" style="text-align:center;">
        <p style="color:var(--text-muted);padding:24px;">No active streams. Share a video from the file browser to create one.</p>
      </div>
    <% } else { %>
      <div class="file-list">
        <% streams.forEach(s => { %>
          <div class="file-row" style="grid-template-columns: 36px 1fr 1fr 110px;">
            <span class="col-icon"><%= s.live ? '🔴' : '🎬' %></span>
            <span class="col-name">
              <strong><%= s.label %></strong>
              <% if (s.live) { %><span class="live-badge" style="margin-left:6px;">LIVE</span><% } %>
              <span style="font-size:11px;color:var(--text-muted);margin-left:6px;">by <%= s.createdBy %></span>
            </span>
            <span class="col-name" style="font-size:12px;">
              <a href="<%= s.url %>" target="_blank" style="color:var(--primary);word-break:break-all;"><%= s.url %></a>
            </span>
            <span class="col-actions">
              <% if (s.canStop) { %>
                <button type="button" class="btn btn-xs btn-danger"
                  data-token="<%= s.token %>"
                  data-label="<%= s.label %>"
                  onclick="openStopConfirm(this)">Stop</button>
              <% } else { %>
                <span style="font-size:11px;color:var(--text-muted);">Admin only</span>
              <% } %>
            </span>
          </div>
        <% }) %>
      </div>
    <% } %>

    <!-- FFmpeg: change default audio track -->
    <details class="ffmpeg-info" style="margin-top:32px;">
      <summary>🎵 How to change default audio track (ffmpeg)</summary>
      <div class="ffmpeg-info-body">
        <p>These commands keep video/subtitles intact, avoid re-encoding (<code>-c copy</code>), and only change the default audio flag.</p>

        <p style="margin-top:12px;font-weight:600;">List audio tracks in a file</p>
        <div class="cmd-block">
          <pre><code>ffmpeg -i movie.mkv</code></pre>
          <button class="btn btn-xs btn-outline cmd-copy" onclick="copyCmd(this)">📋</button>
        </div>
        <div class="cmd-block">
          <pre><code>ffprobe -v error -select_streams a \
  -show_entries stream=index:stream_tags=language \
  -of compact=p=0:nk=1 movie.mkv</code></pre>
          <button class="btn btn-xs btn-outline cmd-copy" onclick="copyCmd(this)">📋</button>
        </div>

        <p style="margin-top:12px;font-weight:600;">Make 1st audio track default</p>
        <div class="cmd-block">
          <pre><code>ffmpeg -i movie.mkv -map 0 \
  -disposition:a:0 default -disposition:a:1 0 \
  -c copy output.mkv</code></pre>
          <button class="btn btn-xs btn-outline cmd-copy" onclick="copyCmd(this)">📋</button>
        </div>

        <p style="margin-top:12px;font-weight:600;">Make 2nd audio track default</p>
        <div class="cmd-block">
          <pre><code>ffmpeg -i movie.mkv -map 0 \
  -disposition:a:0 0 -disposition:a:1 default \
  -c copy output.mkv</code></pre>
          <button class="btn btn-xs btn-outline cmd-copy" onclick="copyCmd(this)">📋</button>
        </div>

        <p style="margin-top:12px;font-weight:600;">Make 3rd audio track default</p>
        <div class="cmd-block">
          <pre><code>ffmpeg -i movie.mkv -map 0 \
  -disposition:a:0 0 -disposition:a:1 0 -disposition:a:2 default \
  -c copy output.mkv</code></pre>
          <button class="btn btn-xs btn-outline cmd-copy" onclick="copyCmd(this)">📋</button>
        </div>
      </div>
    </details>
  </main>

  <!-- Custom confirm modal -->
  <div id="stop-confirm-modal" class="modal-overlay" style="display:none;" onclick="if(event.target===this)closeStopConfirm()">
    <div class="modal" style="max-width:380px;text-align:center;">
      <p style="font-size:32px;margin-bottom:12px;">🛑</p>
      <h3 style="margin-bottom:8px;">Stop Stream?</h3>
      <p id="stop-confirm-label" style="color:var(--text-muted);margin-bottom:24px;font-size:14px;"></p>
      <div style="display:flex;gap:12px;justify-content:center;">
        <button class="btn btn-outline" onclick="closeStopConfirm()">Cancel</button>
        <button id="stop-confirm-btn" class="btn btn-danger">Yes, stop it</button>
      </div>
    </div>
  </div>

  <!-- Snackbar -->
  <div id="snackbar" class="snackbar"></div>

  <script>
    var pendingToken = null;

    function openStopConfirm(btn) {
      pendingToken = btn.dataset.token;
      document.getElementById('stop-confirm-label').textContent = '"' + btn.dataset.label + '"';
      document.getElementById('stop-confirm-modal').style.display = 'flex';
    }

    function closeStopConfirm() {
      document.getElementById('stop-confirm-modal').style.display = 'none';
      pendingToken = null;
    }

    document.getElementById('stop-confirm-btn').addEventListener('click', function() {
      if (!pendingToken) return;
      var token = pendingToken;
      closeStopConfirm();

      fetch('/streams/stop', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: 'token=' + encodeURIComponent(token),
      }).then(function() {
        // Remove stream row from DOM
        var btn = document.querySelector('[data-token="' + token + '"]');
        if (btn) {
          var row = btn.closest('.file-row');
          if (row) {
            row.style.transition = 'opacity 0.3s';
            row.style.opacity = '0';
            setTimeout(function() {
              row.remove();
              // Show empty state if no rows left
              var list = document.querySelector('.file-list');
              if (list && list.querySelectorAll('.file-row').length === 0) {
                list.innerHTML = '<p style="text-align:center;color:var(--text-muted);padding:24px;">No active streams.</p>';
              }
            }, 300);
          }
        }
        showSnackbar('Stream stopped');
      }).catch(function() {
        showSnackbar('Failed to stop stream');
      });
    });

    function showSnackbar(msg) {
      var s = document.getElementById('snackbar');
      s.textContent = msg;
      s.classList.add('active');
      setTimeout(function() { s.classList.remove('active'); }, 3000);
    }

    function copyCmd(btn) {
      var code = btn.closest('.cmd-block').querySelector('code');
      var text = code.textContent.replace(/\\\s*\n\s*/g, ' ').replace(/\s+/g, ' ').trim();
      navigator.clipboard.writeText(text).then(function() {
        btn.textContent = '✅';
        showSnackbar('Copied to clipboard');
        setTimeout(function() { btn.textContent = '📋'; }, 1500);
      });
    }
  </script>
</body>
</html>
