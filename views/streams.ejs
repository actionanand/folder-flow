<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Folder Flow — Active Streams</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="topbar">
    <div class="topbar-left">
      <a href="/" class="logo">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/>
        </svg>
        Folder Flow
      </a>
    </div>
    <div class="topbar-right">
      <a href="/" class="btn btn-sm btn-outline">← Files</a>
    </div>
  </header>

  <main class="container">
    <h2 style="margin-bottom:16px;">🎬 Active Streams</h2>

    <% if (streams.length === 0) { %>
      <div class="info-card" style="text-align:center;">
        <p style="color:var(--text-muted);padding:24px;">No active streams. Share a video from the file browser to create one.</p>
      </div>
    <% } else { %>
      <div class="file-list">
        <% streams.forEach(s => { %>
          <div class="file-row" style="grid-template-columns: 36px 1fr 1fr 80px;">
            <span class="col-icon">🎬</span>
            <span class="col-name"><strong><%= s.label %></strong></span>
            <span class="col-name" style="font-size:12px;">
              <a href="<%= s.url %>" target="_blank" style="color:var(--primary);word-break:break-all;"><%= s.url %></a>
            </span>
            <span class="col-actions">
              <form method="POST" action="/streams/stop" onsubmit="return confirm('Stop this stream?')">
                <input type="hidden" name="token" value="<%= s.token %>">
                <button type="submit" class="btn btn-xs btn-danger">Stop</button>
              </form>
            </span>
          </div>
        <% }) %>
      </div>
    <% } %>
  </main>
</body>
</html>
